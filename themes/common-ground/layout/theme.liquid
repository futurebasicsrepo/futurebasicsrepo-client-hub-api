<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-motion="{{ settings.motion_level }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_bg }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}

  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&family=VT323&display=swap" rel="stylesheet">

  <style>
    :root {
      --c-bg: {{ settings.color_bg }};
      --c-ink: {{ settings.color_ink }};
      --c-paper: {{ settings.color_paper }};
      --c-hot: {{ settings.color_accent_1 }};
      --c-volt: {{ settings.color_accent_2 }};
      --c-acid: {{ settings.color_accent_3 }};
      --c-tang: {{ settings.color_accent_4 }};
      --c-chrome: #c0c0c0;
      --c-chrome-dark: #7a7a7a;
      --c-chrome-light: #ffffff;
      --font-display: 'Archivo Black', Impact, 'Arial Black', sans-serif;
      --font-body: 'Space Grotesk', system-ui, -apple-system, sans-serif;
      --font-pixel: 'VT323', 'Courier New', monospace;
      --radius: {{ settings.corner_radius }}px;
      --page-max: 1440px;
      --gutter: clamp(16px, 3vw, 40px);
      --header-h: 72px;
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  <script src="{{ 'motion.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
  {{ content_for_header }}
</head>

<body class="template-{{ request.page_type | handle }}{% if settings.enable_scanlines %} has-scanlines{% endif %}">
  <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  {%- if settings.enable_scanlines -%}<div class="crt" aria-hidden="true"></div>{%- endif -%}
  {%- if settings.enable_cursor -%}<div class="cursor-sticker" aria-hidden="true">★</div>{%- endif -%}

  {% sections 'header-group' %}

  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
  </ul>

  <script>
    window.theme = {
      routes: {
        cart: '{{ routes.cart_url }}',
        cartAdd: '{{ routes.cart_add_url }}',
        cartChange: '{{ routes.cart_change_url }}',
        cartUpdate: '{{ routes.cart_update_url }}',
        predictiveSearch: '{{ routes.predictive_search_url }}'
      },
      strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        adding: {{ 'products.product.adding' | t | json }},
        added: {{ 'products.product.added' | t | json }}
      },
      moneyFormat: {{ shop.money_format | json }}
    };
  </script>
</body>
</html>
