<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {% render 'meta-tags' %}
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&family=VT323&display=swap" rel="stylesheet">
  <style>
    :root {
      --c-bg: {{ settings.color_bg }}; --c-ink: {{ settings.color_ink }}; --c-paper: {{ settings.color_paper }};
      --c-hot: {{ settings.color_accent_1 }}; --c-volt: {{ settings.color_accent_2 }}; --c-acid: {{ settings.color_accent_3 }}; --c-tang: {{ settings.color_accent_4 }};
      --c-chrome: #c0c0c0; --c-chrome-dark: #7a7a7a; --c-chrome-light: #fff;
      --font-display: 'Archivo Black', Impact, sans-serif; --font-body: 'Space Grotesk', system-ui, sans-serif; --font-pixel: 'VT323', monospace;
      --radius: {{ settings.corner_radius }}px; --page-max: 1440px; --gutter: clamp(16px, 3vw, 40px); --header-h: 72px;
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'motion.js' | asset_url }}" defer="defer"></script>
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="MainContent" class="main-content" role="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
