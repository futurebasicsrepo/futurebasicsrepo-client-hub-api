{% layout none %}
{%- assign gc_value = gift_card.initial_value | money_with_currency -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'gift_cards.issued.title' | t: value: gc_value, shop: shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Space Grotesk', sans-serif; background: {{ settings.color_bg }}; color: {{ settings.color_ink }}; margin: 0; padding: 40px 16px; text-align: center; }
    .card { max-width: 480px; margin: 0 auto; background: #fff; border: 3px solid {{ settings.color_ink }}; box-shadow: 8px 8px 0 {{ settings.color_accent_1 }}; padding: 32px; }
    h1 { font-family: 'Archivo Black', sans-serif; font-size: 28px; margin: 0 0 8px; }
    .code { font-family: monospace; font-size: 24px; letter-spacing: .1em; background: {{ settings.color_accent_3 }}; padding: 12px; border: 2px dashed {{ settings.color_ink }}; }
    a.btn { display: inline-block; margin-top: 24px; padding: 12px 20px; background: {{ settings.color_ink }}; color: #fff; text-decoration: none; font-weight: 700; }
  </style>
</head>
<body>
  <div class="card">
    <h1>{{ 'gift_cards.issued.subtext' | t }}</h1>
    <p>{{ 'gift_cards.issued.title' | t: value: gc_value, shop: shop.name }}</p>
    {% if gift_card.enabled == false or gift_card.expired %}<p><strong>{{ 'gift_cards.issued.expired' | t }}</strong></p>{% endif %}
    <p class="code">{{ gift_card.code | format_code }}</p>
    <p>{{ 'gift_cards.issued.remaining_html' | t: balance: gift_card.balance | money }}</p>
    {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}">{{ 'gift_cards.issued.add_to_apple_wallet' | t }}</a><br>{%- endif -%}
    <a class="btn" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t }}</a>
  </div>
</body>
</html>
