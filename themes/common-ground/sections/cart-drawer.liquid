<div class="cart-drawer" id="CartDrawer" data-cart-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}">
  <div class="cart-drawer__head">
    <h2 class="h4">{{ 'sections.cart.title' | t }} <span class="cart-drawer__count" data-cart-count-label>{{ 'sections.cart.item_count' | t: count: cart.item_count }}</span></h2>
    <button class="icon-btn" type="button" data-cart-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="cart-drawer__body" data-cart-body>
    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer__empty">
        <p class="h3 cart-drawer__empty-face">(・_・;)</p>
        <p>{{ 'sections.cart.empty' | t }}</p>
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}" data-cart-close>{{ 'sections.header.shop_all' | t }}</a>
      </div>
    {%- else -%}
      <ul class="cart-lines">
        {%- for item in cart.items -%}
          <li class="cart-line" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
            <a class="cart-line__media" href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" width="{{ item.image.width }}" height="{{ item.image.height }}" alt="{{ item.image.alt | escape }}" loading="lazy">
              {%- endif -%}
            </a>
            <div class="cart-line__info">
              <p class="cart-line__vendor small">{{ item.vendor }}</p>
              <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="small cart-line__variant">{{ item.variant.title }}</p>{%- endunless -%}
              {%- for p in item.properties -%}{%- unless p.last == blank or p.first contains '_' -%}<p class="small">{{ p.first }}: {{ p.last }}</p>{%- endunless -%}{%- endfor -%}
              <div class="cart-line__row">
                <div class="qty" data-qty>
                  <button type="button" class="qty__btn" data-qty-minus aria-label="-">{% render 'icon', name: 'minus' %}</button>
                  <input class="qty__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-qty-input data-index="{{ forloop.index }}" aria-label="{{ 'sections.cart.quantity' | t }}">
                  <button type="button" class="qty__btn" data-qty-plus aria-label="+">{% render 'icon', name: 'plus' %}</button>
                </div>
                <span class="cart-line__price">{{ item.final_line_price | money }}</span>
              </div>
              <button type="button" class="cart-line__remove small" data-line-remove data-index="{{ forloop.index }}">{{ 'sections.cart.remove' | t }}</button>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
  {%- if cart.item_count > 0 -%}
  <div class="cart-drawer__foot">
    <div class="cart-drawer__subtotal">
      <span>{{ 'sections.cart.subtotal' | t }}</span>
      <strong data-cart-subtotal>{{ cart.total_price | money }}</strong>
    </div>
    <p class="small">{{ 'sections.cart.taxes_and_shipping' | t }}</p>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn--primary btn--block btn--lg">{{ 'sections.cart.checkout' | t }} {% render 'icon', name: 'arrow' %}</button>
    </form>
    <a class="cart-drawer__view small" href="{{ routes.cart_url }}">{{ 'sections.cart.view_cart' | t }}</a>
  </div>
  {%- endif -%}
</div>
<div class="overlay overlay--cart" data-cart-overlay hidden></div>
{% schema %}
{ "name": "Cart drawer", "settings": [] }
{% endschema %}
