<section class="section page-width account">
  <a class="small" href="{{ routes.account_url }}">← {{ 'customer.account.title' | t }}</a>
  <h1 class="h1">{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p class="small">{{ 'customer.order.date_html' | t: date: order.created_at | date: '%b %d, %Y' }}</p>
  {%- if order.cancelled -%}<p class="form__error">{{ 'customer.order.cancelled_html' | t: date: order.cancelled_at | date: '%b %d, %Y' }} — {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}</p>{%- endif -%}
  <table class="cart-table">
    <thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.sku' | t }}</th><th>{{ 'customer.order.price' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th class="right">{{ 'customer.order.total' | t }}</th></tr></thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>{%- if line_item.url -%}<a href="{{ line_item.url }}">{{ line_item.title }}</a>{%- else -%}{{ line_item.title }}{%- endif -%}
            {%- if line_item.fulfillment -%}<p class="small">{{ 'customer.order.fulfilled_at_html' | t: date: line_item.fulfillment.created_at | date: '%b %d, %Y' }}{% if line_item.fulfillment.tracking_url %} · <a href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track_shipment' | t }}</a>{% endif %}</p>{%- endif -%}
          </td>
          <td>{{ line_item.sku }}</td><td>{{ line_item.final_price | money }}</td><td>{{ line_item.quantity }}</td><td class="right">{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr><td colspan="4">{{ 'customer.order.subtotal' | t }}</td><td class="right">{{ order.line_items_subtotal_price | money }}</td></tr>
      {%- for discount_application in order.cart_level_discount_applications -%}<tr><td colspan="4">{{ 'customer.order.discount' | t }} — {{ discount_application.title }}</td><td class="right">-{{ discount_application.total_allocated_amount | money }}</td></tr>{%- endfor -%}
      {%- for shipping_method in order.shipping_methods -%}<tr><td colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td><td class="right">{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
      {%- for tax_line in order.tax_lines -%}<tr><td colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td><td class="right">{{ tax_line.price | money }}</td></tr>{%- endfor -%}
      <tr><td colspan="4"><strong>{{ 'customer.order.total' | t }}</strong></td><td class="right"><strong>{{ order.total_price | money_with_currency }}</strong></td></tr>
    </tfoot>
  </table>
  <div class="account__layout">
    <div><h2 class="h4">{{ 'customer.order.billing_address' | t }}</h2><p class="small">{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>{{ order.billing_address | format_address }}</div>
    <div><h2 class="h4">{{ 'customer.order.shipping_address' | t }}</h2><p class="small">{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>{{ order.shipping_address | format_address }}</div>
  </div>
</section>
{% schema %}{ "name": "Order", "settings": [] }{% endschema %}
