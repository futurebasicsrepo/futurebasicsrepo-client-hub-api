<section class="marquee marquee--{{ section.settings.color_scheme }} marquee--{{ section.settings.size }}" data-marquee data-speed="{{ section.settings.speed }}" aria-label="Brands">
  <div class="marquee__track">
    {%- for i in (1..2) -%}
      <div class="marquee__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span class="marquee__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
            <span class="marquee__sep" aria-hidden="true">{{ section.settings.separator }}</span>
          </span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Marquee",
  "settings": [
    { "type": "range", "id": "speed", "label": "Scroll duration (s)", "min": 10, "max": 120, "step": 5, "default": 40 },
    { "type": "text", "id": "separator", "label": "Separator", "default": "✦" },
    { "type": "select", "id": "size", "label": "Size", "options": [ { "value": "md", "label": "Medium" }, { "value": "lg", "label": "Huge" } ], "default": "lg" },
    { "type": "select", "id": "color_scheme", "label": "Color", "options": [
      { "value": "ink", "label": "Ink" }, { "value": "hot", "label": "Hot" }, { "value": "volt", "label": "Volt" }, { "value": "acid", "label": "Acid" }, { "value": "tang", "label": "Tangerine" }, { "value": "outline", "label": "Outline" }
    ], "default": "acid" }
  ],
  "blocks": [ { "type": "item", "name": "Item", "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "NIKE" },
    { "type": "url", "id": "link", "label": "Link" }
  ] } ],
  "presets": [{ "name": "Marquee", "blocks": [ { "type": "item", "settings": { "text": "NIKE" } }, { "type": "item", "settings": { "text": "ADIDAS" } }, { "type": "item", "settings": { "text": "SUPREME" } } ] }]
}
{% endschema %}
