<section class="password">
  <div class="password__box">
    <p class="kicker">{{ shop.name }}</p>
    <h1 class="h1" data-glitch data-text="{{ 'general.password.title' | t }}">{{ 'general.password.title' | t }}</h1>
    <p>{{ 'general.password.text' | t }}</p>
    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}<p class="form__error small">{{ form.errors.messages['form'] }}</p>{%- endif -%}
      <div class="newsletter-form__row">
        <input type="password" name="password" placeholder="{{ 'general.password.placeholder' | t }}" required>
        <button type="submit" class="btn btn--primary">{{ 'general.password.submit' | t }}</button>
      </div>
    {%- endform -%}
    <p class="small">{{ 'general.password.owner' | t }}<a href="/admin">{{ 'general.password.login' | t }}</a></p>
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
