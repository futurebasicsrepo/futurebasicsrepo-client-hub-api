<section class="newsletter section">
  <div class="newsletter__inner page-width">
    <div class="newsletter__copy">
      <h2 class="h2 reveal">{{ section.settings.heading }}</h2>
      <p class="reveal" style="--i:1">{{ section.settings.text }}</p>
    </div>
    {%- form 'customer', class: 'newsletter-form newsletter-form--big reveal', style: '--i:2' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter.label' | t }}</label>
      <div class="newsletter-form__row">
        <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required autocomplete="email">
        <button type="submit" class="btn btn--primary">{{ 'general.newsletter.submit' | t }} {% render 'icon', name: 'arrow' %}</button>
      </div>
      {%- if form.posted_successfully? -%}<p class="form__success">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="form__error">{{ 'general.newsletter.error' | t }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don't miss the drop." },
    { "type": "text", "id": "text", "label": "Text", "default": "New consignment lands weekly. Get it in your inbox before it hits the floor." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
