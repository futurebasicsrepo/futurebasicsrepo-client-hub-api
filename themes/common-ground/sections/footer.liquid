<footer class="footer" data-footer>
  <div class="footer__top page-width">
    <div class="footer__brand">
      <p class="footer__wordmark">{% render 'logo', class: 'footer__logo-svg', uid: 'ftr' %}</p>
      {%- if section.settings.tagline != blank -%}<p class="footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
      <div class="footer__social">
        {%- if settings.social_instagram != blank -%}<a class="icon-btn" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a class="icon-btn" href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a class="icon-btn" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div class="footer__col" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'menu' -%}
            <p class="footer__heading">{{ block.settings.heading }}</p>
            <ul class="footer__links">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- when 'text' -%}
            <p class="footer__heading">{{ block.settings.heading }}</p>
            <div class="footer__text rte">{{ block.settings.text }}</div>
          {%- when 'newsletter' -%}
            <p class="footer__heading">{{ block.settings.heading }}</p>
            {%- form 'customer', class: 'newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter.label' | t }}</label>
              <div class="newsletter-form__row">
                <input id="FooterEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required autocomplete="email">
                <button type="submit" class="btn btn--primary btn--sm">{{ 'general.newsletter.submit' | t }}</button>
              </div>
              {%- if form.posted_successfully? -%}<p class="form__success small">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}
              {%- if form.errors -%}<p class="form__error small">{{ 'general.newsletter.error' | t }}</p>{%- endif -%}
            {%- endform -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="footer__marquee" data-marquee data-speed="60" aria-hidden="true">
    <div class="marquee__track">
      {%- for i in (1..2) -%}
        <div class="marquee__group">
          {%- for j in (1..6) -%}<span class="footer__marquee-item">{{ shop.name }} <span class="marquee__sep">★</span></span>{%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  <div class="footer__bottom page-width">
    <p class="small">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright }}</p>
    <div class="footer__legal small">
      {%- for link in linklists[section.settings.legal_menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    </div>
    <p class="small footer__credit">Site by <a href="https://thefuturebasics.com" target="_blank" rel="noopener">Future Basics</a></p>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Sneakers · Streetwear · Collectibles. Center City Philadelphia." },
    { "type": "text", "id": "copyright", "label": "Copyright note", "default": "All rights reserved." },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "default": "footer" }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
    ] },
    { "type": "text", "name": "Text", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Visit" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>134 S 11th St<br>Philadelphia, PA 19107</p><p>Mon–Thu 12–7<br>Fri–Sat 12–8<br>Sun 12–5</p>" }
    ] },
    { "type": "newsletter", "name": "Newsletter", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Drops, restocks, in-store events." }
    ] }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop", "menu": "main-menu" } },
      { "type": "text" },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
