<section class="rich-text section page-width rich-text--{{ section.settings.align }}">
  {%- if section.settings.kicker != blank -%}<p class="kicker reveal">{{ section.settings.kicker }}</p>{%- endif -%}
  {%- if section.settings.heading != blank -%}<h2 class="h1 reveal" style="--i:1">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="rte reveal" style="--i:2">{{ section.settings.text }}</div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy. Sell. Trade." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Bring your heat to 134 S 11th St. We authenticate on the spot.</p>" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
