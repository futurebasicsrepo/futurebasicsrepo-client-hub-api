{%- if section.blocks.size > 0 -%}
<div class="announcement-bar announcement-bar--{{ section.settings.color_scheme }}" role="region" aria-label="Announcement" data-marquee data-speed="{{ section.settings.speed }}">
  <div class="marquee__track">
    {%- for i in (1..2) -%}
      <div class="marquee__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <span class="announcement-bar__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
            <span class="marquee__sep" aria-hidden="true">✦</span>
          </span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement ticker",
  "class": "section-announcement",
  "settings": [
    { "type": "range", "id": "speed", "label": "Scroll duration (s)", "min": 10, "max": 90, "step": 5, "default": 30 },
    { "type": "select", "id": "color_scheme", "label": "Color", "options": [
      { "value": "ink", "label": "Ink" }, { "value": "hot", "label": "Hot" }, { "value": "volt", "label": "Volt" }, { "value": "acid", "label": "Acid" }
    ], "default": "ink" }
  ],
  "blocks": [
    { "type": "text", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "FREE SHIPPING OVER $150" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Announcement ticker" }]
}
{% endschema %}
