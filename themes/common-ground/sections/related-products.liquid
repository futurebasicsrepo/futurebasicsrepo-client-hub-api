<section class="related section page-width" data-density="{{ settings.grid_density }}">
  {%- if recommendations.performed -%}
    {%- if recommendations.products_count > 0 -%}
      <div class="section__head"><h2 class="h2 section__title">{{ section.settings.heading }}</h2></div>
      <div class="product-grid product-grid--4">
        {%- for p in recommendations.products limit: 4 -%}{% render 'product-card', product: p, index: forloop.index %}{%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4"></div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Related products", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "You might also rock" } ] }
{% endschema %}
