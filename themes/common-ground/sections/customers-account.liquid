<section class="section page-width account">
  <div class="section__head"><h1 class="h1">{{ 'customer.account.title' | t }}</h1><a class="btn btn--ghost" href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a></div>
  <div class="account__layout">
    <div>
      <h2 class="h3">{{ 'customer.orders.title' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="cart-table">
            <thead><tr><th>{{ 'customer.orders.order_number' | t }}</th><th>{{ 'customer.orders.date' | t }}</th><th>{{ 'customer.orders.payment_status' | t }}</th><th>{{ 'customer.orders.fulfillment_status' | t }}</th><th class="right">{{ 'customer.orders.total' | t }}</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%b %d, %Y' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.fulfillment_status_label }}</td><td class="right">{{ order.total_price | money }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p>{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <aside>
      <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
      <p>{{ customer.name }}<br>{{ customer.email }}</p>
      {%- if customer.default_address -%}{{ customer.default_address | format_address }}{%- endif -%}
      <a class="btn btn--ghost btn--sm" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})</a>
    </aside>
  </div>
</section>
{% schema %}{ "name": "Account", "settings": [] }{% endschema %}
