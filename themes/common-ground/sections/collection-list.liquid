{%- liquid
  assign list = section.blocks
  assign palette = 'hot,volt,acid,tang' | split: ','
-%}
<section class="collection-list section page-width">
  <div class="section__head">
    {%- if section.settings.heading != blank -%}<h2 class="h2 section__title reveal">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.show_all -%}<a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">{{ 'sections.header.shop_all' | t }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
  </div>
  <div class="collection-list__grid">
    {%- if list.size > 0 -%}
      {%- for block in list -%}
        {%- assign c = block.settings.collection -%}
        {%- assign pidx = forloop.index0 | modulo: 4 -%}
        {%- assign color = palette[pidx] -%}
        {%- if c != blank -%}
          <a class="ctile ctile--{{ color }} reveal" href="{{ c.url }}" data-tilt style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="ctile__media">
              {%- assign ci = block.settings.image | default: c.image | default: c.products.first.featured_image -%}
              {%- if ci -%}<img src="{{ ci | image_url: width: 800 }}" width="{{ ci.width }}" height="{{ ci.height }}" alt="{{ c.title | escape }}" loading="lazy">{%- endif -%}
            </div>
            <div class="ctile__body">
              <span class="ctile__title">{{ block.settings.title | default: c.title }}</span>
              <span class="ctile__cta">{{ 'sections.collection.shop_all_in' | t: collection: c.title }} <span class="ctile__num">{{ c.all_products_count }}</span></span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- assign i = 0 -%}
      {%- for c in collections -%}
        {%- unless c.handle == 'all' or c.handle == 'frontpage' or c.all_products_count == 0 -%}
          {%- if i < section.settings.auto_limit -%}
            {%- assign pidx = i | modulo: 4 -%}
            {%- assign color = palette[pidx] -%}
            <a class="ctile ctile--{{ color }} reveal" href="{{ c.url }}" data-tilt style="--i:{{ i }}">
              <div class="ctile__media">
                {%- assign ci = c.image | default: c.products.first.featured_image -%}
                {%- if ci -%}<img src="{{ ci | image_url: width: 800 }}" width="{{ ci.width }}" height="{{ ci.height }}" alt="{{ c.title | escape }}" loading="lazy">{%- endif -%}
              </div>
              <div class="ctile__body">
                <span class="ctile__title">{{ c.title }}</span>
                <span class="ctile__cta">{{ 'sections.collection.shop_all_in' | t: collection: c.title }} <span class="ctile__num">{{ c.all_products_count }}</span></span>
              </div>
            </a>
            {%- assign i = i | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Collection tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick a lane" },
    { "type": "checkbox", "id": "show_all", "label": "Show 'Shop all' button", "default": true },
    { "type": "range", "id": "auto_limit", "label": "Auto mode: max collections", "info": "Used when no blocks are added — every non-empty collection is shown automatically.", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "blocks": [ { "type": "collection", "name": "Collection", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "title", "label": "Override title" },
    { "type": "image_picker", "id": "image", "label": "Override image" }
  ] } ],
  "presets": [{ "name": "Collection tiles" }]
}
{% endschema %}
