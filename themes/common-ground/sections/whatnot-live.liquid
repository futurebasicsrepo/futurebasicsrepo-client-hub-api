{%- liquid
  assign url = section.settings.url | default: settings.whatnot_url
  assign live = settings.whatnot_live
  assign next_at = settings.whatnot_next
  assign next_title = settings.whatnot_next_title
  assign shows = section.blocks | where: 'type', 'show'
  assign reruns = section.blocks | where: 'type', 'rerun'
-%}
<section class="ch12 section{% if live %} ch12--live{% endif %}" id="channel-12" data-channel-12>
  <div class="page-width">
    <div class="section__head">
      <div>
        <p class="kicker reveal">{{ section.settings.kicker }}</p>
        <h2 class="h2 section__title reveal" style="--i:1" data-glitch data-text="{{ section.settings.heading | escape }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if url != blank -%}<a class="btn btn--ghost reveal" style="--i:2" href="{{ url }}" target="_blank" rel="noopener">{{ section.settings.follow_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </div>

    <div class="ch12__layout">
      {%- comment -%} ---------- The TV set ---------- {%- endcomment -%}
      <div class="tv reveal" data-tilt data-tilt-max="3">
        <div class="tv__bezel">
          <div class="tv__screen">
            <div class="tv__static" aria-hidden="true"></div>
            <div class="osd tv__osd" aria-hidden="true"><span>CH 12</span></div>
            {%- if live -%}
              <div class="tv__content tv__content--live">
                <p class="tv__live"><span class="onair__dot" aria-hidden="true"></span> LIVE</p>
                <p class="tv__title">{{ next_title | default: 'We are on right now' }}</p>
                <a class="btn btn--primary btn--lg tv__cta" href="{{ url }}" target="_blank" rel="noopener">{{ section.settings.tune_in_label }} {% render 'icon', name: 'arrow' %}</a>
              </div>
            {%- else -%}
              <div class="tv__content">
                <p class="tv__label">{{ section.settings.next_label }}</p>
                <p class="tv__title">{{ next_title }}</p>
                {%- if next_at != blank -%}
                  <div class="tv__countdown" data-countdown="{{ next_at | escape }}" data-fallback="{{ section.settings.offair_text | escape }}">
                    <span class="tv__cd"><b data-cd-d>00</b><i>days</i></span>
                    <span class="tv__cd"><b data-cd-h>00</b><i>hrs</i></span>
                    <span class="tv__cd"><b data-cd-m>00</b><i>min</i></span>
                    <span class="tv__cd"><b data-cd-s>00</b><i>sec</i></span>
                  </div>
                {%- else -%}
                  <p class="tv__offair">{{ section.settings.offair_text }}</p>
                {%- endif -%}
                {%- if url != blank -%}<a class="btn btn--chrome tv__cta" href="{{ url }}" target="_blank" rel="noopener">{{ section.settings.remind_label }}</a>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
          <div class="tv__controls" aria-hidden="true">
            <span class="tv__plate">{{ shop.name }}</span>
            <span class="tv__knob"></span><span class="tv__knob tv__knob--sm"></span>
            <span class="tv__grille"></span>
          </div>
        </div>
        <div class="tv__feet" aria-hidden="true"><span></span><span></span></div>
        {%- if live -%}<div class="tv__sticker" data-spin>{% render 'sticker', text: 'ON AIR', color: 'hot', size: 'md' %}</div>{%- endif -%}
      </div>

      {%- comment -%} ---------- TV guide ---------- {%- endcomment -%}
      <div class="guide reveal" style="--i:1" aria-label="Upcoming shows">
        <div class="guide__head" data-marquee data-speed="24">
          <div class="marquee__track">
            {%- for i in (1..2) -%}<div class="marquee__group" {% if i == 2 %}aria-hidden="true"{% endif %}>{%- for j in (1..3) -%}<span class="guide__ticker">{{ section.settings.guide_ticker }}<span class="marquee__sep">✦</span></span>{%- endfor -%}</div>{%- endfor -%}
          </div>
        </div>
        <div class="guide__rows">
          {%- for block in shows -%}
            <a class="guide__row{% if forloop.first %} guide__row--next{% endif %}" href="{{ block.settings.url | default: url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
              <span class="guide__when"><b>{{ block.settings.day }}</b>{{ block.settings.time }}</span>
              <span class="guide__what"><b>{{ block.settings.title }}</b>{% if block.settings.category != blank %}<span class="guide__cat">{{ block.settings.category }}</span>{% endif %}</span>
              <span class="guide__ch">CH 12</span>
            </a>
          {%- else -%}
            <p class="guide__empty">Add shows in the theme editor → Channel 12 → Add show.</p>
          {%- endfor -%}
        </div>
        <p class="guide__foot">{{ section.settings.guide_note }}</p>
      </div>
    </div>

    {%- comment -%} ---------- Reruns shelf ---------- {%- endcomment -%}
    {%- if reruns.size > 0 -%}
      <div class="reruns">
        <p class="kicker">{{ section.settings.reruns_heading }}</p>
        <div class="reruns__shelf">
          {%- for block in reruns -%}
            {%- assign spine = forloop.index0 | modulo: 4 -%}
            <a class="vhs vhs--{{ spine }} reveal" style="--i:{{ forloop.index0 }}" href="{{ block.settings.url | default: url }}" target="_blank" rel="noopener" data-tilt {{ block.shopify_attributes }}>
              <span class="vhs__label"><b>{{ block.settings.title }}</b><i>{{ block.settings.date }}</i></span>
              <span class="vhs__spine-text">REC ● SP</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Channel 12 — Whatnot live",
  "class": "section-whatnot",
  "settings": [
    { "type": "paragraph", "content": "Live state, next-show time and the channel URL live in Theme settings → Whatnot live, so the ON AIR badge and this section stay in sync." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "NOW BROADCASTING" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Channel 12" },
    { "type": "text", "id": "url", "label": "Override channel URL", "info": "Leave blank to use Theme settings." },
    { "type": "text", "id": "follow_label", "label": "Follow button", "default": "Follow on Whatnot" },
    { "type": "text", "id": "tune_in_label", "label": "Tune in button (live)", "default": "Tune in now" },
    { "type": "text", "id": "remind_label", "label": "Reminder button (off air)", "default": "Set a reminder" },
    { "type": "text", "id": "next_label", "label": "Off-air label", "default": "NEXT SHOW IN" },
    { "type": "text", "id": "offair_text", "label": "Off-air text when no date set", "default": "Off air. Follow us for the next drop." },
    { "type": "text", "id": "guide_ticker", "label": "Guide ticker", "default": "COMMON GROUND TV · LIVE AUCTIONS · BUY IT NOW · SHIPS FROM PHILLY" },
    { "type": "text", "id": "guide_note", "label": "Guide footnote", "default": "All times Eastern. Shows stream on Whatnot; bids and Buy-It-Now happen in the app." },
    { "type": "text", "id": "reruns_heading", "label": "Reruns heading", "default": "RERUNS — past shows" }
  ],
  "blocks": [
    { "type": "show", "name": "Show", "settings": [
      { "type": "text", "id": "day", "label": "Day", "default": "FRI" },
      { "type": "text", "id": "time", "label": "Time", "default": "7:00 PM" },
      { "type": "text", "id": "title", "label": "Title", "default": "Friday Night Heat" },
      { "type": "text", "id": "category", "label": "Category", "default": "Sneakers" },
      { "type": "url", "id": "url", "label": "Show link (optional)" }
    ] },
    { "type": "rerun", "name": "Rerun (past show)", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Vintage Tee Tapes Vol. 1" },
      { "type": "text", "id": "date", "label": "Date", "default": "SEP 12" },
      { "type": "url", "id": "url", "label": "Replay link" }
    ] }
  ],
  "presets": [ { "name": "Channel 12 — Whatnot live", "blocks": [
    { "type": "show", "settings": { "day": "FRI", "time": "7:00 PM", "title": "Friday Night Heat", "category": "Jordans · Dunks · Vintage" } },
    { "type": "show", "settings": { "day": "SAT", "time": "2:00 PM", "title": "Toy Box", "category": "Collectibles · Bearbricks · Cards" } },
    { "type": "show", "settings": { "day": "SUN", "time": "6:00 PM", "title": "Sunday Steals", "category": "Under $100 · Tees · Hats" } },
    { "type": "rerun", "settings": { "title": "Vintage Tee Tapes Vol. 1", "date": "SEP 12" } },
    { "type": "rerun", "settings": { "title": "Grail Night: Chicago 1s", "date": "SEP 5" } },
    { "type": "rerun", "settings": { "title": "Back to School Dunks", "date": "AUG 29" } }
  ] } ]
}
{% endschema %}
