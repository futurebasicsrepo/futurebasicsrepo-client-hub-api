{%- liquid
  assign menu = section.settings.menu
  assign shop_menu = section.settings.shop_menu
  assign all_url = routes.all_products_collection_url
-%}
<header class="header{% if section.settings.sticky %} header--sticky{% endif %}" data-header>
  <div class="header__inner page-width">
    <button class="icon-btn header__burger" type="button" data-menu-open aria-controls="MobileMenu" aria-expanded="false" aria-label="{{ 'accessibility.open_menu' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>

    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" alt="{{ shop.name | escape }}" style="max-width: {{ section.settings.logo_width }}px" loading="eager">
      {%- else -%}
        {% render 'logo', class: 'header__logo-svg', uid: 'hdr' %}
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul class="nav">
        <li class="nav__item nav__item--mega">
          <a href="{{ all_url }}" class="nav__link" aria-haspopup="true" aria-expanded="false" data-mega-trigger>{{ 'sections.header.shop_all' | t }} {% render 'icon', name: 'chevron' %}</a>
          <div class="mega" data-mega>
            <div class="mega__inner page-width">
              <div class="mega__col mega__col--hero">
                <a href="{{ all_url }}" class="mega__all">
                  <span class="mega__all-kicker">{{ 'sections.collection.all_products' | t }}</span>
                  <span class="mega__all-title">{{ 'sections.header.shop_all' | t }} →</span>
                </a>
                <a href="{{ all_url }}?sort_by=created-descending" class="mega__link mega__link--strong">New arrivals</a>
                <a href="{{ all_url }}?filter.v.availability=1" class="mega__link mega__link--strong">In stock now</a>
              </div>
              <div class="mega__col">
                <p class="mega__heading">Collections</p>
                <ul class="mega__list">
                  {%- if shop_menu != blank and linklists[shop_menu].links.size > 0 -%}
                    {%- for link in linklists[shop_menu].links -%}
                      <li><a class="mega__link" href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for c in collections limit: 24 -%}
                      {%- unless c.handle == 'all' or c.handle == 'frontpage' -%}
                        <li><a class="mega__link" href="{{ c.url }}">{{ c.title }}<span class="mega__num">{{ c.all_products_count }}</span></a></li>
                      {%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              </div>
              <div class="mega__col mega__col--tiles">
                {%- assign tile_i = 0 -%}
                {%- for c in collections -%}
                  {%- if c.image and tile_i < 2 and c.handle != 'all' -%}
                    {%- assign tile_i = tile_i | plus: 1 -%}
                    <a href="{{ c.url }}" class="mega__tile" data-tilt>
                      <img src="{{ c.image | image_url: width: 400 }}" width="{{ c.image.width }}" height="{{ c.image.height }}" alt="{{ c.title | escape }}" loading="lazy">
                      <span class="mega__tile-label">{{ 'sections.collection.shop_all_in' | t: collection: c.title }}</span>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </li>
        {%- for link in linklists[menu].links -%}
          {%- unless link.url == all_url -%}
          <li class="nav__item{% if link.links.size > 0 %} nav__item--has-children{% endif %}">
            <a href="{{ link.url }}" class="nav__link{% if link.active or link.child_active %} is-active{% endif %}">{{ link.title }}{% if link.links.size > 0 %} {% render 'icon', name: 'chevron' %}{% endif %}</a>
            {%- if link.links.size > 0 -%}
              <ul class="nav__dropdown">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}" class="nav__dropdown-link">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__actions">
      <form action="{{ routes.search_url }}" method="get" role="search" class="header__search" data-search>
        <label class="visually-hidden" for="HeaderSearch">{{ 'general.search.title' | t }}</label>
        <input id="HeaderSearch" type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" value="{{ search.terms | escape }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="icon-btn" aria-label="{{ 'general.search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
      </form>
      <button class="icon-btn header__search-toggle" type="button" data-search-toggle aria-label="{{ 'accessibility.open_search' | t }}">{% render 'icon', name: 'search' %}</button>
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn header__account" href="{{ routes.account_url }}" aria-label="{{ 'sections.header.account' | t }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <button class="icon-btn header__cart{% if cart.item_count > 0 %} has-items{% endif %}" type="button" data-cart-open aria-label="{{ 'accessibility.open_cart' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="MobileMenu" data-mobile-menu aria-hidden="true">
    <div class="mobile-menu__head">
      <span class="h5">{{ 'sections.header.menu' | t }}</span>
      <button class="icon-btn" type="button" data-menu-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <ul class="mobile-menu__list">
      <li><a class="mobile-menu__link mobile-menu__link--all" href="{{ all_url }}">{{ 'sections.header.shop_all' | t }} {% render 'icon', name: 'arrow' %}</a></li>
      <li>
        <details class="mobile-menu__group" open>
          <summary class="mobile-menu__link">Collections {% render 'icon', name: 'chevron' %}</summary>
          <ul>
            {%- if shop_menu != blank and linklists[shop_menu].links.size > 0 -%}
              {%- for link in linklists[shop_menu].links -%}<li><a class="mobile-menu__sub" href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            {%- else -%}
              {%- for c in collections limit: 24 -%}{%- unless c.handle == 'all' or c.handle == 'frontpage' -%}<li><a class="mobile-menu__sub" href="{{ c.url }}">{{ c.title }} <span class="mega__num">{{ c.all_products_count }}</span></a></li>{%- endunless -%}{%- endfor -%}
            {%- endif -%}
          </ul>
        </details>
      </li>
      {%- for link in linklists[menu].links -%}
        {%- unless link.url == all_url -%}
        <li>
          {%- if link.links.size > 0 -%}
            <details class="mobile-menu__group">
              <summary class="mobile-menu__link">{{ link.title }} {% render 'icon', name: 'chevron' %}</summary>
              <ul>{%- for child in link.links -%}<li><a class="mobile-menu__sub" href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}</ul>
            </details>
          {%- else -%}
            <a class="mobile-menu__link" href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </li>
        {%- endunless -%}
      {%- endfor -%}
      {%- if shop.customer_accounts_enabled -%}
        <li><a class="mobile-menu__link" href="{{ routes.account_url }}">{% if customer %}{{ 'sections.header.account' | t }}{% else %}{{ 'sections.header.log_in' | t }}{% endif %}</a></li>
      {%- endif -%}
    </ul>
    <div class="mobile-menu__foot">
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
      {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
      {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
    </div>
  </div>
  <div class="overlay" data-overlay hidden></div>
</header>

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  {% if section.settings.logo %}"logo": {{ section.settings.logo | image_url: width: 500 | prepend: "https:" | json }},{% endif %}
  "sameAs": [{{ settings.social_instagram | json }}, {{ settings.social_facebook | json }}],
  "url": {{ request.origin | append: page.url | json }}
}
</script>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 300, "step": 10, "unit": "px", "default": 160 },
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu", "info": "Shop all is always first. Add pages like Sell / Contact here." },
    { "type": "link_list", "id": "shop_menu", "label": "Shop dropdown menu", "info": "Optional. If empty, the dropdown lists every collection automatically with live counts." },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true }
  ]
}
{% endschema %}
