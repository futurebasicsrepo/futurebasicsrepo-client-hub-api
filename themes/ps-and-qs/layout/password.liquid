<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {% render 'meta-tags' %}
  <style>
    @font-face { font-family: 'Fraunces'; src: url('{{ 'fraunces.woff2' | asset_url }}') format('woff2-variations'); font-weight: 100 900; font-display: swap; }
    @font-face { font-family: 'Inter Tight'; src: url('{{ 'inter-tight.woff2' | asset_url }}') format('woff2-variations'); font-weight: 100 900; font-display: swap; }
    @font-face { font-family: 'DM Mono'; src: url('{{ 'dm-mono.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-display: swap; }
    :root {
      --c-paper: {{ settings.color_paper }}; --c-sheet: {{ settings.color_sheet }}; --c-ink: {{ settings.color_ink }};
      --c-red: {{ settings.color_red }}; --c-jade: {{ settings.color_jade }}; --c-gold: {{ settings.color_gold }};
      --c-ink-rgb: {{ settings.color_ink.red }}, {{ settings.color_ink.green }}, {{ settings.color_ink.blue }};
      --font-display: 'Fraunces', Georgia, serif; --font-body: 'Inter Tight', system-ui, sans-serif; --font-mono: 'DM Mono', ui-monospace, monospace;
      --radius: {{ settings.corner_radius }}px; --page-max: 1480px; --gutter: clamp(16px, 3.2vw, 48px); --header-h: 68px;
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'motion.js' | asset_url }}" defer="defer"></script>
  {{ content_for_header }}
</head>
<body class="template-password{% if settings.enable_grain %} has-grain{% endif %}" data-motion="{{ settings.motion_level }}">
  <main id="MainContent" class="main-content" role="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
