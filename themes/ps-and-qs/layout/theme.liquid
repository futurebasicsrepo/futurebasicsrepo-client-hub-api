<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-motion="{{ settings.motion_level }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_paper }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {{ 'fraunces.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'inter-tight.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif -%}

  {%- liquid
    comment
      Index hygiene. Thin auto-generated pages (vendor/type lookups, tag-filtered and
      facet-filtered collection URLs, internal search) stay crawlable for link discovery
      but out of the index, so Google and AI answer engines cite the real collection page.
    endcomment
    assign noindex = false
    if request.page_type == 'search' or current_tags
      assign noindex = true
    endif
    if request.page_type == 'collection'
      if collection.handle == 'vendors' or collection.handle == 'types'
        assign noindex = true
      endif
      for f in collection.filters
        if f.active_values.size > 0
          assign noindex = true
        endif
      endfor
    endif
    if template.suffix == 'llms'
      assign noindex = true
    endif
  -%}
  {%- if noindex -%}<meta name="robots" content="noindex, follow">{%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {% render 'meta-description' %}
  {% render 'meta-tags' %}
  {%- if settings.llms_page != blank -%}
    <link rel="alternate" type="text/markdown" title="{{ shop.name }} for AI assistants" href="{{ settings.llms_page.url }}">
  {%- endif -%}

  <style>
    @font-face { font-family: 'Fraunces'; src: url('{{ 'fraunces.woff2' | asset_url }}') format('woff2-variations'); font-weight: 100 900; font-style: normal; font-display: swap; }
    @font-face { font-family: 'Fraunces'; src: url('{{ 'fraunces-italic.woff2' | asset_url }}') format('woff2-variations'); font-weight: 100 900; font-style: italic; font-display: swap; }
    @font-face { font-family: 'Inter Tight'; src: url('{{ 'inter-tight.woff2' | asset_url }}') format('woff2-variations'); font-weight: 100 900; font-style: normal; font-display: swap; }
    @font-face { font-family: 'DM Mono'; src: url('{{ 'dm-mono.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
    :root {
      --c-paper: {{ settings.color_paper }};
      --c-sheet: {{ settings.color_sheet }};
      --c-ink: {{ settings.color_ink }};
      --c-red: {{ settings.color_red }};
      --c-jade: {{ settings.color_jade }};
      --c-gold: {{ settings.color_gold }};
      --c-ink-rgb: {{ settings.color_ink.red }}, {{ settings.color_ink.green }}, {{ settings.color_ink.blue }};
      --font-display: 'Fraunces', 'Iowan Old Style', Georgia, serif;
      --font-body: 'Inter Tight', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --font-mono: 'DM Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
      --radius: {{ settings.corner_radius }}px;
      --page-max: 1480px;
      --gutter: clamp(16px, 3.2vw, 48px);
      --header-h: 68px;
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  <script src="{{ 'motion.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'fit.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
  {%- if settings.enable_view_transitions -%}
    <style>@view-transition { navigation: auto; }</style>
  {%- endif -%}
  {{ content_for_header }}
  {% render 'structured-data' %}
</head>

<body class="template-{{ request.page_type | handle }}{% if template.suffix %} template-suffix-{{ template.suffix | handle }}{% endif %}{% if settings.enable_grain %} has-grain{% endif %}">
  <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
  {%- if settings.enable_cursor -%}<div class="type-cursor" aria-hidden="true"><span>q</span></div>{%- endif -%}

  {% sections 'header-group' %}

  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}
  {% render 'fit-profile' %}

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
  </ul>

  <script>
    window.theme = {
      routes: {
        root: {{ routes.root_url | json }},
        cart: '{{ routes.cart_url }}',
        cartAdd: '{{ routes.cart_add_url }}',
        cartChange: '{{ routes.cart_change_url }}',
        cartUpdate: '{{ routes.cart_update_url }}',
        predictiveSearch: '{{ routes.predictive_search_url }}'
      },
      strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        adding: {{ 'products.product.adding' | t | json }},
        added: {{ 'products.product.added' | t | json }},
        inYourSize: {{ 'products.product.in_your_size' | t | json }}
      },
      moneyFormat: {{ shop.money_format | json }}
    };
  </script>
</body>
</html>
