    "house": {
      "type": "image-with-text",
      "settings": {
        "kicker": "The house line",
        "heading": "Made in Philly, worn everywhere",
        "text": "<p>Ps & Qs is our own label: heavyweight fleece, logo tees and one-off capsules with neighbors like the Philadelphia Union and Pat's King of Steaks. Designed on South Street, made for the city.</p>",
        "button_label": "Shop Ps & Qs",
        "button_link": "/collections/ps-qs"
      }
    },
    "block": {
      "type": "the-block",
      "blocks": {
        "moment1": {
          "type": "moment",
          "settings": {
            "year": "2008",
            "partner": "Chinatown",
            "title": "Before Ps & Qs: Abakus Takeout",
            "text": "<p>The first shop: 227 N 10th St, dressed as a Chinese takeout — tees packed in takeout boxes.</p>"
          }
        },
        "moment2": {
          "type": "moment",
          "settings": {
            "year": "2012",
            "partner": "South Street",
            "title": "Doors open at 820 South St",
            "text": "<p>Brothers Ky and Rick Cao and their friend Jackson Fu open Ps & Qs. The name comes from the Philly saying: get your Ps and Qs in order.</p>"
          }
        },
        "moment3": {
          "type": "moment",
          "settings": {
            "year": "2015",
            "partner": "Tretorn × Publish",
            "title": "The \"Better Days\" Nylite",
            "text": "<p>A three-way sneaker collab in suede tan and perforated white leather.</p>",
            "link": "/products/tretorn-x-publish-x-ps-and-qs-nylite-suede"
          }
        },
        "moment4": {
          "type": "moment",
          "settings": {
            "year": "2016",
            "partner": "Antique Row",
            "title": "Ps & Qs For Her on Pine Street",
            "text": "<p>A sister shop at 1018 Pine St — later named Best of Philly's best sister shop.</p>"
          }
        },
        "moment5": {
          "type": "moment",
          "settings": {
            "year": "2019",
            "partner": "Ubiq × Lapstone & Hammer",
            "title": "Seven years, three shops, one capsule",
            "text": "<p>Philly's sneaker shops teamed up on an anniversary tee drop instead of competing.</p>"
          }
        },
        "moment6": {
          "type": "moment",
          "settings": {
            "year": "2020",
            "partner": "Philadelphia Suns",
            "title": "Fight The Virus, Not The People",
            "text": "<p>A response to anti-Asian hate. 25% of proceeds went to the Chinatown youth nonprofit. Sold out.</p>"
          }
        },
        "moment7": {
          "type": "moment",
          "settings": {
            "year": "2025",
            "partner": "Philadelphia Union",
            "title": "Year of the Snake",
            "text": "<p>A Lunar New Year and AAPI Heritage Month capsule for the Union's Philly Crafted series.</p>",
            "link": "/blogs/news/dear-philadelphia-union"
          }
        },
        "moment8": {
          "type": "moment",
          "settings": {
            "year": "2026",
            "partner": "Hat Club",
            "title": "The Group Chat Pack",
            "text": "<p>Phillies fitteds with friends of the shop, launched at a South Street pop-up.</p>"
          }
        }
      },
