{%- comment -%} The composing stick: a line of set type that runs with your scroll (and reverses when you scroll up). {%- endcomment -%}
<section class="stick" aria-label="{{ section.settings.label | escape }}">
  <div class="stick__track" data-marquee data-scroll-velocity>
    {%- for i in (1..2) -%}
      <ul class="stick__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <li class="stick__item{% cycle '', ' stick__item--outline' %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}"{% if i == 2 %} tabindex="-1"{% endif %}>{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
          </li>
          <li class="stick__sep" aria-hidden="true">{% cycle 'p', 'q' %}</li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Composing stick (marquee)",
  "settings": [ { "type": "text", "id": "label", "label": "Accessible label", "default": "Brands we carry" } ],
  "blocks": [ { "type": "item", "name": "Item", "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Carhartt WIP" },
    { "type": "url", "id": "link", "label": "Link" }
  ] } ],
  "presets": [ { "name": "Composing stick", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
