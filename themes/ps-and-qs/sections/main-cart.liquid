<section class="section page-width cart-page">
  <h1 class="h1">{{ 'sections.cart.title' | t }}</h1>
  {%- if cart.item_count == 0 -%}
    <div class="empty"><p class="empty__glyph" aria-hidden="true">q</p><p>{{ 'sections.cart.empty' | t }}</p><a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'sections.header.shop_all' | t }}</a></div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__form">
      {% render 'ship-meter' %}
      <table class="cart-table">
        <thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th class="right">{{ 'customer.order.total' | t }}</th></tr></thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td class="cart-table__product">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" width="80" height="{{ 80 | divided_by: item.image.aspect_ratio | round }}" alt="{{ item.image.alt | default: item.product.title | escape }}" loading="lazy">{%- endif -%}
                <span><span class="mono small">{{ item.vendor }}</span><br><a href="{{ item.url }}">{{ item.product.title }}</a>{%- unless item.product.has_only_default_variant -%}<br><span class="small">{{ item.variant.title }}</span>{%- endunless -%}</span>
              </td>
              <td><input class="qty__input qty__input--solo" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'sections.cart.quantity' | t }}"> <a class="small link" href="{{ item.url_to_remove }}">{{ 'sections.cart.remove' | t }}</a></td>
              <td class="right">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      <div class="cart-page__foot">
        <label class="cart-page__note">{{ 'sections.cart.note' | t }}<textarea name="note" rows="3">{{ cart.note }}</textarea></label>
        <div class="cart-page__totals">
          <p class="cart-drawer__subtotal"><span>{{ 'sections.cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></p>
          <p class="small">{{ 'sections.cart.taxes_and_shipping' | t }}</p>
          <button type="submit" name="update" class="btn btn--ghost">{{ 'sections.cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn--primary btn--lg">{{ 'sections.cart.checkout' | t }} {% render 'icon', name: 'arrow' %}</button>
          {%- if additional_checkout_buttons -%}<div class="cart-page__dynamic">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
        </div>
      </div>
    </form>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
