{%- if section.blocks.size > 0 -%}
<div class="ticker" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
  <div class="ticker__track" data-marquee>
    {%- for i in (1..2) -%}
      <ul class="ticker__group"{% if i == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <li class="ticker__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}"{% if i == 2 %} tabindex="-1"{% endif %}>{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
            <span class="ticker__sep" aria-hidden="true">{% cycle 'p', 'q' %}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement ticker",
  "max_blocks": 8,
  "blocks": [ { "type": "text", "name": "Message", "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $250" },
    { "type": "url", "id": "link", "label": "Link" }
  ] } ],
  "presets": [ { "name": "Announcement ticker" } ]
}
{% endschema %}
