<section class="password">
  <div class="password__box">
    {% render 'logo' %}
    <h1 class="h2 offreg" data-offreg>{{ 'general.password.title' | t }}</h1>
    <p>{{ 'general.password.text' | t }}</p>
    {%- form 'customer', class: 'news-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,password">
      {%- if form.posted_successfully? -%}<p class="form__success small">{{ 'sections.newsletter.success' | t }}</p>{%- endif -%}
      <div class="news-form__row"><input type="email" name="contact[email]" placeholder="{{ 'sections.newsletter.email' | t }}" aria-label="{{ 'sections.newsletter.email' | t }}" required><button type="submit" class="btn btn--primary">{{ 'sections.newsletter.submit' | t }}</button></div>
    {%- endform -%}
    <details class="password__owner small"><summary>{{ 'general.password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'news-form' -%}
        {%- if form.errors -%}<p class="form__error small">{{ form.errors.messages['form'] }}</p>{%- endif -%}
        <div class="news-form__row"><input type="password" name="password" placeholder="{{ 'general.password.placeholder' | t }}" aria-label="{{ 'general.password.placeholder' | t }}" required><button type="submit" class="btn btn--ghost">{{ 'general.password.submit' | t }}</button></div>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
