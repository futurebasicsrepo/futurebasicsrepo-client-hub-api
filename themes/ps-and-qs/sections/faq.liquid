{%- comment -%}
  Real answers to the questions people (and AI assistants) ask, rendered as accordions and
  marked up as FAQPage so they can be quoted directly.
{%- endcomment -%}
<section class="faq section" aria-labelledby="Faq-{{ section.id }}">
  <div class="page-width faq__grid">
    <header>
      <p class="mono kicker">{{ section.settings.kicker }}</p>
      <h2 class="h2 offreg" id="Faq-{{ section.id }}" data-offreg>{{ section.settings.heading }}</h2>
    </header>
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
          <summary>{{ block.settings.question }} {% render 'icon', name: 'plus' %}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [{% for block in section.blocks %}{ "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}{% endfor %}]
}
</script>
{%- endif -%}
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Mind your" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" }
  ],
  "blocks": [ { "type": "qa", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question", "default": "Do you take returns?" },
    { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>We do exchanges within 30 days.</p>" }
  ] } ],
  "presets": [ { "name": "FAQ", "blocks": [ { "type": "qa" } ] } ]
}
{% endschema %}
