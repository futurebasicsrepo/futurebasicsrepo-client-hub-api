<section class="search section page-width" id="ProductGrid" data-collection data-section-id="{{ section.id }}">
  <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
    <label class="visually-hidden" for="SearchPage">{{ 'general.search.title' | t }}</label>
    <div class="search__row">
      <input id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="btn btn--primary">{{ 'general.search.submit' | t }}</button>
    </div>
  </form>
  {%- if search.performed -%}
    <h1 class="h2 search__title">{{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}</h1>
    {%- paginate search.results by 24 -%}
      <div class="collection__layout collection__layout--sidebar">
        <aside class="collection__facets">{% render 'facets', results: search, section_id: section.id, results_count: search.results_count %}</aside>
        <div class="collection__results" data-results>
          {%- if search.results_count == 0 -%}
            <div class="empty">
              <p class="empty__glyph" aria-hidden="true">q</p>
              <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
              <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'sections.header.shop_all' | t }}</a>
            </div>
          {%- else -%}
            <div class="grid grid--{{ settings.grid_density }}">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item, index: forloop.index %}
                {%- else -%}
                  <article class="card card--text reveal">
                    <p class="mono small">{{ item.object_type }}</p>
                    <h3 class="card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                    <p class="small">{{ item.content | strip_html | truncatewords: 20 }}</p>
                  </article>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {% render 'pagination', paginate: paginate, anchor: '#ProductGrid' %}
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  {%- else -%}
    <h1 class="h1 search__title">{{ 'general.search.title' | t }}</h1>
    <div class="chips">
      {%- for c in collections limit: 16 -%}{%- if c.all_products_count > 0 -%}<a class="chip" href="{{ c.url }}">{{ c.title }}</a>{%- endif -%}{%- endfor -%}
    </div>
  {%- endif -%}
</section>
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
