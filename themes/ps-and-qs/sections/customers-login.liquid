<section class="section page-width page--narrow account">
  <h1 class="h1">{{ 'customer.login.title' | t }}</h1>
  {%- form 'customer_login', class: 'form' -%}
    {%- if form.errors -%}<div class="form__error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label>{{ 'customer.login.email' | t }}<input type="email" name="customer[email]" autocomplete="email" required></label>
    <label>{{ 'customer.login.password' | t }}<input type="password" name="customer[password]" autocomplete="current-password" required></label>
    <button type="submit" class="btn btn--primary">{{ 'customer.login.sign_in' | t }}</button>
    <p class="small"><a href="#recover">{{ 'customer.login.forgot_password' | t }}</a> · <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a></p>
  {%- endform -%}
  <div id="recover" class="account__recover">
    <h2 class="h3">{{ 'customer.recover_password.title' | t }}</h2>
    <p class="small">{{ 'customer.recover_password.subtext' | t }}</p>
    {%- form 'recover_customer_password', class: 'form' -%}
      {%- if form.posted_successfully? -%}<p class="form__success small">{{ 'customer.recover_password.success' | t }}</p>{%- endif -%}
      {%- if form.errors -%}<div class="form__error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label>{{ 'customer.login.email' | t }}<input type="email" name="email" autocomplete="email" required></label>
      <button type="submit" class="btn btn--ghost">{{ 'customer.recover_password.submit' | t }}</button>
    {%- endform -%}
  </div>
  {%- if shop.checkout.guest_login -%}
    <h2 class="h3">{{ 'customer.login.guest_title' | t }}</h2>
    {%- form 'guest_login' -%}<button type="submit" class="btn btn--ghost">{{ 'customer.login.guest_continue' | t }}</button>{%- endform -%}
  {%- endif -%}
</section>
{% schema %}{ "name": "Login", "settings": [] }{% endschema %}
