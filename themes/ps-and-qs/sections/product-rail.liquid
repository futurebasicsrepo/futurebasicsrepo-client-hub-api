{%- comment -%}
  Horizontal rail of product cards. Mode "fit" filters the rail client-side to the shopper's
  saved sizes (fit.js) with a toggle back to everything — the right product for the right person
  without an app. ItemList JSON-LD helps crawlers understand the curated set.
{%- endcomment -%}
{%- assign c = section.settings.collection -%}
<section class="rail section{% if section.settings.mode == 'fit' %} rail--fit{% endif %}" data-rail data-rail-mode="{{ section.settings.mode }}">
  <div class="page-width">
    <header class="section__head">
      <div>
        <p class="mono kicker">{{ section.settings.kicker }}</p>
        <h2 class="h2 offreg" data-offreg>{{ section.settings.heading | default: c.title }}</h2>
        {%- if section.settings.mode == 'fit' -%}
          <p class="small rail__fit-note" data-rail-fit-note hidden>{{ 'fit.rail_note' | t }} <button type="button" class="link" data-rail-show-all>{{ 'fit.show_everything' | t }}</button></p>
          <p class="small rail__fit-note" data-rail-fit-empty><button type="button" class="link" data-fit-open>{{ 'fit.set_sizes' | t }}</button> {{ 'fit.rail_empty' | t }}</p>
        {%- endif -%}
      </div>
      <div class="rail__nav">
        <button type="button" class="icon-btn" data-rail-prev aria-label="{{ 'general.slider.previous' | t }}">{% render 'icon', name: 'arrow' %}</button>
        <button type="button" class="icon-btn" data-rail-next aria-label="{{ 'general.slider.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
        {%- if c -%}<a class="link-arrow" href="{{ c.url }}{% if section.settings.sort != blank %}?sort_by={{ section.settings.sort }}{% endif %}">{{ 'sections.collection.shop_all_in' | t: collection: c.title }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      </div>
    </header>
  </div>
  <div class="rail__track" data-rail-track tabindex="0" aria-label="{{ section.settings.heading | default: c.title | escape }}">
    {%- if c.products.size > 0 -%}
      {%- liquid
        if section.settings.sort == 'created-descending'
          assign list = c.products | sort: 'created_at' | reverse
        else
          assign list = c.products
        endif
      -%}
      {%- for product in list limit: section.settings.limit -%}
        {% render 'product-card', product: product, lazy: true, index: forloop.index %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        <article class="card"><div class="card__media"><div class="card__placeholder">{{ 'apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div></div><div class="card__info"><p class="card__vendor mono">Brand</p><h3 class="card__title">Product title</h3></div></article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{%- if c.products.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org", "@type": "ItemList", "name": {{ section.settings.heading | default: c.title | json }},
  "itemListElement": [{% for product in c.products limit: section.settings.limit %}{ "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ request.origin | append: product.url | json }} }{% unless forloop.last %},{% endunless %}{% endfor %}]
}
</script>
{%- endif -%}
{% schema %}
{
  "name": "Product rail",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Fresh off the press" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Just printed" },
    { "type": "select", "id": "sort", "label": "Order", "options": [ { "value": "", "label": "Collection order" }, { "value": "created-descending", "label": "Newest first" } ], "default": "" },
    { "type": "select", "id": "mode", "label": "Mode", "options": [
      { "value": "all", "label": "Everything" },
      { "value": "fit", "label": "In the shopper's saved sizes first" }
    ], "default": "all" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 24, "step": 1, "default": 12 }
  ],
  "presets": [ { "name": "Product rail" } ]
}
{% endschema %}
