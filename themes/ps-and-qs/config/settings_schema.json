[
  {
    "name": "theme_info",
    "theme_name": "Ps & Qs — Mind Your",
    "theme_version": "1.0.0",
    "theme_author": "Future Basics",
    "theme_documentation_url": "https://thefuturebasics.com",
    "theme_support_url": "https://thefuturebasics.com/pages/contact"
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_paper", "label": "Paper (page background)", "default": "#F2EDE3" },
      { "type": "color", "id": "color_sheet", "label": "Sheet (cards, drawers)", "default": "#FBF8F2" },
      { "type": "color", "id": "color_ink", "label": "Ink (text, rules)", "default": "#141210" },
      { "type": "color", "id": "color_red", "label": "Press red (primary action, prices on sale)", "default": "#D2261C" },
      { "type": "color", "id": "color_jade", "label": "Jade (second ink, in-your-size)", "default": "#0F6B5A" },
      { "type": "color", "id": "color_gold", "label": "Gold leaf (highlights)", "default": "#E7B23A" }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "select", "id": "motion_level", "label": "Motion level",
        "info": "Visitors with reduced motion turned on in their OS always get the still version.",
        "options": [
          { "value": "full", "label": "Full (mirror glyphs, press-roll reveals, off-register type, cursor)" },
          { "value": "medium", "label": "Medium (reveals and tickers only)" },
          { "value": "off", "label": "Off" }
        ],
        "default": "full"
      },
      { "type": "checkbox", "id": "enable_cursor", "label": "Type-sort cursor (desktop)", "info": "A small mirrored q follows the pointer and prints as a p over links.", "default": true },
      { "type": "checkbox", "id": "enable_grain", "label": "Paper grain texture", "default": true },
      { "type": "checkbox", "id": "enable_hover_swap", "label": "Roll to second image on product hover", "default": true },
      { "type": "checkbox", "id": "enable_view_transitions", "label": "Page transitions (View Transitions API)", "default": true }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 2 },
      { "type": "select", "id": "grid_density", "label": "Product grid density", "options": [
        { "value": "3", "label": "3 per row" }, { "value": "4", "label": "4 per row" }, { "value": "5", "label": "5 per row" }
      ], "default": "4" },
      { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave blank to use the typeset wordmark. Also used as the logo in structured data." },
      { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 240, "step": 4, "unit": "px", "default": 120 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "checkbox", "id": "card_show_vendor", "label": "Show brand", "default": true },
      { "type": "checkbox", "id": "card_show_sizes", "label": "Show in-stock sizes", "default": true },
      { "type": "checkbox", "id": "card_quick_add", "label": "Quick add (tap a size to add)", "default": true },
      { "type": "text", "id": "badge_new_days", "label": "Mark products as New for N days", "default": "14" },
      { "type": "text", "id": "house_vendor", "label": "House brand vendor name", "info": "Products from this vendor get the house mark on cards. Use one spelling for the brand across every product.", "default": "Ps & Qs" }
    ]
  },
  {
    "name": "Fit profile",
    "settings": [
      { "type": "paragraph", "content": "Shoppers save their sizes once. Collections then get an \"In my size\" switch, cards flag items in their size, and product pages pre-select it. Sizes are stored only in the shopper's browser." },
      { "type": "checkbox", "id": "fit_enabled", "label": "Enable fit profile", "default": true },
      { "type": "text", "id": "fit_tops", "label": "Top sizes (comma separated)", "default": "XS, S, M, L, XL, XXL" },
      { "type": "text", "id": "fit_bottoms", "label": "Waist sizes (comma separated)", "default": "28, 29, 30, 31, 32, 33, 34, 36, 38" },
      { "type": "text", "id": "fit_shoes", "label": "Shoe sizes (comma separated)", "default": "7, 7.5, 8, 8.5, 9, 9.5, 10, 10.5, 11, 11.5, 12, 13" },
      { "type": "text", "id": "fit_option_name", "label": "Size option name on products", "default": "Size" }
    ]
  },
  {
    "name": "Store & brand facts",
    "settings": [
      { "type": "paragraph", "content": "These facts feed Google, Maps and AI answer engines (schema.org structured data and /pages/llms). Keep them exact." },
      { "type": "text", "id": "brand_legal_name", "label": "Brand name (one spelling)", "default": "Ps & Qs" },
      { "type": "text", "id": "brand_alt_names", "label": "Other spellings people search", "default": "P's & Q's, Ps and Qs, Ps&Qs, Premium Quality" },
      { "type": "textarea", "id": "brand_summary", "label": "One-paragraph description", "default": "Ps & Qs is a family-owned streetwear and lifestyle shop on South Street in Philadelphia, open since 2012. It stocks hand-picked brands like Carhartt WIP, Stüssy, New Balance, Pendleton, Universal Works and Norse Projects alongside its own Philly-made Ps & Qs line." },
      { "type": "text", "id": "founding_year", "label": "Founded (year)", "default": "2012" },
      { "type": "text", "id": "founders", "label": "Founders (comma separated)", "default": "Ky Cao, Rick Cao, Jackson Fu" },
      { "type": "text", "id": "street", "label": "Street address", "default": "820 South St" },
      { "type": "text", "id": "city", "label": "City", "default": "Philadelphia" },
      { "type": "text", "id": "region", "label": "State", "default": "PA" },
      { "type": "text", "id": "postal", "label": "ZIP", "default": "19147" },
      { "type": "text", "id": "phone", "label": "Phone", "default": "+1-215-592-0888" },
      { "type": "text", "id": "hours_weekday", "label": "Hours Mon–Sat (24h, e.g. 12:00-19:00)", "default": "12:00-19:00" },
      { "type": "text", "id": "hours_sunday", "label": "Hours Sunday (24h)", "default": "12:00-18:00" },
      { "type": "text", "id": "free_shipping_over", "label": "Free shipping over (number)", "default": "250" },
      { "type": "text", "id": "exchange_days", "label": "Exchange window (days)", "info": "Policy today: exchanges only, no refunds.", "default": "30" },
      { "type": "url", "id": "maps_url", "label": "Google Maps link" },
      { "type": "page", "id": "llms_page", "label": "AI assistant page (template page.llms)", "info": "Create a page with the page.llms template, pick it here, then add a URL redirect from /llms.txt to it." }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_x", "label": "X" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" }
    ]
  }
]
