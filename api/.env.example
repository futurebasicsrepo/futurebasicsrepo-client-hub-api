DATABASE_URL=postgres://postgres@localhost:5432/incha
JWT_SECRET=change-me-to-a-long-random-string
# Optional: separate key for signing private/unlisted media URLs (defaults to JWT_SECRET)
MEDIA_SECRET=
# Comma-separated. `https://*.vercel.app` style wildcards allow preview deploys.
ALLOWED_ORIGINS=http://localhost:3000,https://incha.tv,https://www.incha.tv
# Public URL of this API, used to build media links (defaults to the request host)
PUBLIC_API_URL=https://api.incha.tv
MEDIA_DIR=./media
MAX_MEDIA_BYTES=500000000
